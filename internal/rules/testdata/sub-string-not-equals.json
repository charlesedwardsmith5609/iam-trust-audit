{
  "Statement": {
    "Effect": "Allow",
    "Action": "sts:AssumeRoleWithWebIdentity",
    "Principal": {"Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"},
    "Condition": {"StringNotEquals": {"token.actions.githubusercontent.com:sub": "repo:example-org/example-repo:ref:refs/heads/main"}}
  }
}
